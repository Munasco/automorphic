---
import "../styles/automorphic.css";
import { RELEASES_URL } from "../lib/releases";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Download Automorphic for your desktop." />
    <link rel="icon" href="/automorphic-icon.svg?v=2" type="image/svg+xml" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <title>Download — Automorphic</title>
  </head>
  <body class="signup-page">
    <header><a class="brand" href="/" aria-label="Automorphic home"><img src="/automorphic-mark.svg" width="34" height="34" alt="" />Automorphic</a></header>
    <main class="content download-layout">
      <p class="eyebrow">Your trading workspace</p>
      <h1>A clearer view.<br />On your desktop.</h1>
      <p id="download-status" role="status" aria-live="polite">Finding the latest downloads…</p>
      <div id="downloads" class="download-options"></div>
      <p class="release-link"><a href={RELEASES_URL}>All releases on GitHub</a></p>
    </main>
  </body>
</html>
<script>
  import { fetchLatestRelease, detectPlatform, downloadLabel } from "../lib/releases";
  const status = document.getElementById("download-status")!;
  const downloads = document.getElementById("downloads")!;
  const platform = navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent) ? null : detectPlatform(navigator.userAgent);
  try {
    const release = await fetchLatestRelease();
    if (!release) {
      status.textContent = "Downloads are coming soon. We'll email you when your preview is ready.";
    } else {
      const assets = release.assets.map((asset) => ({ asset, info: downloadLabel(asset.name)! }));
      assets.sort((a, b) => Number(b.info.platform === platform) - Number(a.info.platform === platform));
      status.textContent = platform && assets.some(({info}) => info.platform === platform) ? "Choose the build for your computer." : "Available desktop builds. More devices are on the way.";
      for (const {asset, info} of assets) {
        const link = document.createElement("a");
        link.className = "primary";
        link.href = asset.browser_download_url;
        link.textContent = `Download for ${info.label}`;
        downloads.append(link);
      }
    }
  } catch {
    status.textContent = "Couldn't load downloads. Try again, or browse the releases on GitHub.";
  }
</script>
<style>
  .download-layout { padding-top: 180px; padding-bottom: 100px; max-width: 920px; }
  h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.1; margin-bottom: 28px; }
  #download-status { color: #b4c1d8; max-width: 560px; }
  .download-options { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
  .release-link { margin-top: 28px; color: #b4c1d8; font-size: 15px; }
</style>
