---
import WaitlistForm from "../components/WaitlistForm.astro";
import "../styles/automorphic.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Join the Automorphic early preview. Your charts, AI research, and macro context in one trading workspace." />
    <meta name="theme-color" content="#080b12" />
    <link rel="icon" href="/automorphic-icon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <title>Join the early preview — Automorphic</title>
  </head>
  <body class="signup-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="brand" href="/" aria-label="Automorphic home"><img src="/automorphic-mark.svg" width="34" height="34" alt="" />Automorphic</a>
      <a class="text-link signup-back" href="/">Back to home <span aria-hidden="true">↗</span></a>
    </header>
    <main class="signup-layout content" id="main">
      <section class="signup-intro">
        <p class="eyebrow">Early preview</p>
        <h1>A clearer view<br />of the markets.</h1>
        <p>Your charts, AI research, and macro context. One trading workspace.</p>
      </section>
      <section class="signup-card" aria-labelledby="signup-title">
        <h2 id="signup-title">Get early access.</h2>
        <p>Be first to try Automorphic.</p>
        <WaitlistForm />
      </section>
    </main>
  </body>
</html>
