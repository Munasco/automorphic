# Public client/build configuration only. Never put credentials in VITE_* values.
# The application currently has hosted Automorphic account defaults. Set BOTH URLs
# to your own Convex deployment for an independent installation.
# See docs/operations/self-hosting.md.
VITE_AUTOMORPHIC_AUTH_URL=https://your-deployment.convex.site
VITE_AUTOMORPHIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional T3 Connect integration: use your own Clerk and relay deployment.
# Leaving these commented does not configure T3 Connect.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# T3CODE_RELAY_URL=https://relay.example.com
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Optional signed macOS passkeys: keep provisioning files outside the repository.
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/development.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev

# Optional Telegram app identity for Telegram channel signal streaming (self-hosting).
# AUTOMORPHIC_TELEGRAM_API_ID=
# AUTOMORPHIC_TELEGRAM_API_HASH=
